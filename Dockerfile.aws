# Image for the YPM app host on AWS (arm64), built by .github/workflows/deploy.yml.
# Mirrors Railway's Railpack build (Node 22, npm ci, prisma generate, next build).
# Build-time values (NEXT_PUBLIC_*) arrive in .aws-build.env, which the workflow
# writes from SSM /ypm/prod/build/po_app/; Next inlines them into the bundles.
# The root filesystem is read-only at runtime: .next/cache and /tmp are tmpfs.

FROM public.ecr.aws/docker/library/node:22.23.2-bookworm-slim AS build
# Prisma's schema engine links against OpenSSL.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# lib/prisma.ts creates the client when page data is collected, which needs
# DATABASE_URL set (never connected to during the build).
RUN if [ -f .aws-build.env ]; then cp .aws-build.env .env.production.local; fi \
  && node_modules/.bin/prisma generate \
  && DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build NEXT_TELEMETRY_DISABLED=1 \
    node_modules/.bin/next build \
  && rm -rf .next/cache

FROM public.ecr.aws/docker/library/node:22.23.2-bookworm-slim
RUN apt-get update && apt-get upgrade -y \
  && apt-get install -y --no-install-recommends ca-certificates openssl \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app /app
USER 1000:1000
ENV NODE_ENV=production PORT=8080 HOME=/tmp NEXT_TELEMETRY_DISABLED=1 CHECKPOINT_DISABLE=1
EXPOSE 8080
# Railway ran `prisma generate && prisma migrate deploy && next start`; the client
# is generated at build time.
CMD ["sh", "-c", "node_modules/.bin/prisma migrate deploy && exec node_modules/.bin/next start"]
